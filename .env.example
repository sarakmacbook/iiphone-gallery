# Telegram bot (optional for the Vercel website converter; required for Telegram sign-in/webhooks)
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_ROOT=https://api.telegram.org

# Local / always-on Node server settings
PORT=8080
WEB_ONLY=false
MAX_UPLOAD_MB=20
MAX_OUTPUT_MB=50
MAX_DIMENSION=3840
ALLOW_CUSTOM=true
MAX_CONCURRENT_JOBS=2
FFMPEG_PATH=
WEB_CONVERT=true
WEB_MAX_UPLOAD_MB=200
WEB_JOB_TTL_MINUTES=60
WEB_API_KEY=
CORS_ORIGIN=*
LOGIN_MAX_AGE_SECONDS=86400
LOGIN_GREETING=true

# Vercel (serverless defaults: 100 MB upload/output and 50 seconds; configure overrides in Project Settings)
# Vercel only: set WEB_MAX_UPLOAD_MB=100 if you want the documented default.
BLOB_READ_WRITE_TOKEN=
PUBLIC_URL=
WEB_MAX_OUTPUT_MB=100
WEB_MAX_SECONDS=50
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_SETUP_SECRET=
CRON_SECRET=
DOWNLOAD_SIGNING_SECRET=
