{
  "name": "sendable-bot",
  "private": true,
  "version": "1.0.0",
  "description": "Sendable Telegram bot: makes smaller copies of iPhone videos. Also includes an MP4 converter bot.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "dev:mp4": "tsx watch --env-file-if-exists=.env src/mp4-index.ts",
    "start:mp4": "node --env-file-if-exists=.env dist/mp4-index.js",
    "test": "tsx --test src/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.3.0"
  },
  "dependencies": {
    "grammy": "^1.46.0"
  }
}
